{
  "name": "rive-lipsync-previewer",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Rive lip sync previewer with browser Rhubarb WASM and optional TTS proxy",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.mjs",
    "dev": "node server.mjs",
    "dev:web": "npm --prefix web run dev",
    "dev:web:chrome": "npm --prefix web run dev:chrome",
    "patch:edge-tts": "node scripts/patch-edge-tts.mjs",
    "test:tts": "node --test scripts/test-tts-protocol.mjs",
    "build:web": "npm --prefix web run build",
    "build": "node scripts/build-web.mjs",
    "postinstall": "node scripts/build-web.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "node-edge-tts": "1.2.12"
  }
}
